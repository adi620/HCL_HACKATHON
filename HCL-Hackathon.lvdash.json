    {
      "name": "top5_cust_netvol",
      "displayName": "Top 5 Customers by Net Transaction Volume",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  dc.CUSTOMER_NAME AS customer_name,\n  SUM(CASE WHEN ft.STD_IS_REFUND = true THEN -ft.PARSED_AMOUNT ELSE ft.PARSED_AMOUNT END) AS net_volume,\n  COUNT(*) AS txn_count\nFROM datastore.gold.fact_transactions ft LEFT JOIN datastore.gold.dim_customers dc ON ft.CUSTOMER_LHID = dc.LHID WHERE ft.PARSED_AMOUNT IS NOT NULL AND dc.CUSTOMER_NAME IS NOT NULL GROUP BY dc.CUSTOMER_NAME ORDER BY net_volume DESC, txn_count DESC LIMIT 5\n",
        "dimensions": [
          {
            "name": "customer_name",
            "expr": "customer_name",
            "displayName": "Customer Name"
          }
        ],
        "measures": [
          {
            "name": "net_volume",
            "expr": "SUM(net_volume)",
            "displayName": "Net Transaction Volume",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "txn_count",
            "expr": "SUM(txn_count)",
            "displayName": "Transaction Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "dormant_accts",
      "displayName": "Dormant Inactive Accounts",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  dc.CUSTOMER_NAME AS customer_name,\n  dc.ACCOUNT_ID AS account_id,\n  dc.LHID AS customer_lhid,\n  lt.last_txn_date,\n  CASE\n    WHEN lt.last_txn_date IS NULL THEN 9999\n    ELSE DATEDIFF(CURRENT_DATE(), lt.last_txn_date)\n  END AS days_inactive,\n  CASE\n    WHEN lt.last_txn_date IS NULL THEN 'Never Active'\n    ELSE 'Dormant'\n  END AS account_status,\n  CASE\n    WHEN hr.high_risk = 1 THEN 'High-Risk Dormant'\n    ELSE 'Dormant'\n  END AS risk_flag,\n  CASE\n    WHEN hr.high_risk = 1 THEN 1\n    ELSE 0\n  END AS is_high_risk\nFROM datastore.gold.dim_customers dc\nLEFT JOIN (\n  SELECT CUSTOMER_LHID, MAX(PARSED_DATE) AS last_txn_date\n  FROM datastore.gold.fact_transactions\n  WHERE PARSED_DATE IS NOT NULL\n  GROUP BY CUSTOMER_LHID\n) lt ON dc.LHID = lt.CUSTOMER_LHID\nLEFT JOIN (\n  SELECT DISTINCT ft.CUSTOMER_LHID, 1 AS high_risk\n  FROM datastore.gold.fact_transactions ft\n  JOIN datastore.gold.dim_products dp ON ft.PRODUCT_LHID = dp.LHID\n  WHERE dp.PRODUCT_TYPE IN ('CREDIT CARD', 'LOAN')\n) hr ON dc.LHID = hr.CUSTOMER_LHID\nWHERE lt.last_txn_date IS NULL OR lt.last_txn_date < DATE_SUB(CURRENT_DATE(), 90)\n",
        "dimensions": [
          {
            "name": "customer_name",
            "expr": "customer_name",
            "displayName": "Customer Name"
          },
          {
            "name": "account_id",
            "expr": "account_id",
            "displayName": "Account ID"
          },
          {
            "name": "account_status",
            "expr": "account_status",
            "displayName": "Account Status"
          },
          {
            "name": "risk_flag",
            "expr": "risk_flag",
            "displayName": "Risk Flag"
          },
          {
            "name": "last_txn_date",
            "expr": "last_txn_date",
            "displayName": "Last Transaction Date"
          }
        ],
        "measures": [
          {
            "name": "days_inactive",
            "expr": "AVG(days_inactive)",
            "displayName": "Avg Days Inactive",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "dormant_count",
            "expr": "COUNT(*)",
            "displayName": "Dormant Account Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "high_risk_count",
            "expr": "SUM(is_high_risk)",
            "displayName": "High-Risk Dormant Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "kyc_risk_exposure",
      "displayName": "KYC Risk Exposure",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  kyc_status_group,\n  total_amount,\n  txn_count,\n  ROUND((total_amount / SUM(total_amount) OVER ()) * 100, 2) AS pct_of_total_value,\n  ROUND((txn_count * 100.0 / SUM(txn_count) OVER ()), 2) AS pct_of_txn_count\nFROM (\n  SELECT\n    CASE\n      WHEN UPPER(TRIM(dc.KYC_STATUS)) = 'VERIFIED' THEN 'Verified'\n      WHEN dc.KYC_STATUS IS NULL OR TRIM(dc.KYC_STATUS) = '' THEN 'Unknown'\n      ELSE 'Not Verified'\n    END AS kyc_status_group,\n    SUM(ft.PARSED_AMOUNT) AS total_amount,\n    COUNT(*) AS txn_count\n  FROM datastore.gold.fact_transactions ft\n  LEFT JOIN datastore.gold.dim_customers dc ON ft.CUSTOMER_LHID = dc.LHID\n  WHERE ft.PARSED_AMOUNT IS NOT NULL\n  GROUP BY\n    CASE\n      WHEN UPPER(TRIM(dc.KYC_STATUS)) = 'VERIFIED' THEN 'Verified'\n      WHEN dc.KYC_STATUS IS NULL OR TRIM(dc.KYC_STATUS) = '' THEN 'Unknown'\n      ELSE 'Not Verified'\n    END\n) t\n",
        "dimensions": [
          {
            "name": "kyc_status_group",
            "expr": "kyc_status_group",
            "displayName": "KYC Status"
          }
        ],
        "measures": [
          {
            "name": "total_amount",
            "expr": "SUM(total_amount)",
            "displayName": "Total Transaction Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "txn_count",
            "expr": "SUM(txn_count)",
            "displayName": "Transaction Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "pct_of_total_value",
            "expr": "AVG(pct_of_total_value)",
            "displayName": "% of Total Value",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "pct_of_txn_count",
            "expr": "AVG(pct_of_txn_count)",
            "displayName": "% of Total Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "prod_revenue_contribution",
      "displayName": "Product Revenue Contribution",
      "config": {
        "version": "1.1",
        "source": "WITH max_date AS (\n  SELECT MAX(STD_TRANSACTION_DATE) AS max_dt\n  FROM datastore.gold.fact_transactions\n  WHERE STD_TRANSACTION_DATE IS NOT NULL\n),\nquarter_data AS (\n  SELECT\n    dp.PRODUCT_NAME AS product_name,\n    dp.CATEGORY AS category,\n    CASE\n      WHEN ft.STD_IS_REFUND = true THEN -ft.PARSED_AMOUNT\n      ELSE ft.PARSED_AMOUNT\n    END AS amount,\n    CASE\n      WHEN ft.STD_TRANSACTION_DATE >= DATE_TRUNC('quarter', (SELECT max_dt FROM max_date))\n        AND ft.STD_TRANSACTION_DATE < DATE_TRUNC('quarter', (SELECT max_dt FROM max_date)) + INTERVAL '3' MONTH\n      THEN 'Current Quarter'\n      WHEN ft.STD_TRANSACTION_DATE >= DATE_TRUNC('quarter', (SELECT max_dt FROM max_date)) - INTERVAL '3' MONTH\n        AND ft.STD_TRANSACTION_DATE < DATE_TRUNC('quarter', (SELECT max_dt FROM max_date))\n      THEN 'Prior Quarter'\n      ELSE NULL\n    END AS period\n  FROM datastore.gold.fact_transactions ft\n  JOIN datastore.gold.dim_products dp ON ft.PRODUCT_LHID = dp.LHID\n  WHERE ft.PARSED_AMOUNT IS NOT NULL\n    AND ft.STD_TRANSACTION_DATE IS NOT NULL\n),\naggregated AS (\n  SELECT\n    product_name,\n    category,\n    period,\n    SUM(amount) AS revenue\n  FROM quarter_data\n  WHERE period IS NOT NULL\n  GROUP BY product_name, category, period\n)\nSELECT\n  product_name,\n  category,\n  period,\n  revenue,\n  ROUND(revenue * 100.0 / SUM(revenue) OVER (PARTITION BY period), 2) AS revenue_share_pct\nFROM aggregated\n",
        "dimensions": [
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product Name"
          },
          {
            "name": "category",
            "expr": "category",
            "displayName": "Category"
          },
          {
            "name": "period",
            "expr": "period",
            "displayName": "Period"
          }
        ],
        "measures": [
          {
            "name": "revenue",
            "expr": "SUM(revenue)",
            "displayName": "Revenue",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "revenue_share_pct",
            "expr": "AVG(revenue_share_pct)",
            "displayName": "Revenue Share %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "refund_rate_prod_branch",
      "displayName": "Refund Rate by Product Branch",
      "config": {
        "version": "1.1",
        "source": "SELECT\n  dp.PRODUCT_NAME AS product_name,\n  dp.CATEGORY AS product_category,\n  db.BRANCH_NAME AS branch_name,\n  db.REGION AS branch_region,\n  COUNT(*) AS total_txn_count,\n  SUM(CASE WHEN ft.STD_IS_REFUND = true THEN 1 ELSE 0 END) AS refund_count,\n  SUM(ABS(ft.PARSED_AMOUNT)) AS total_value,\n  SUM(CASE WHEN ft.STD_IS_REFUND = true THEN ABS(ft.PARSED_AMOUNT) ELSE 0 END) AS refund_value,\n  ROUND(SUM(CASE WHEN ft.STD_IS_REFUND = true THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS refund_count_pct,\n  ROUND(SUM(CASE WHEN ft.STD_IS_REFUND = true THEN ABS(ft.PARSED_AMOUNT) ELSE 0 END) * 100.0 / NULLIF(SUM(ABS(ft.PARSED_AMOUNT)), 0), 2) AS refund_value_pct\nFROM datastore.gold.fact_transactions ft\nJOIN datastore.gold.dim_products dp ON ft.PRODUCT_LHID = dp.LHID\nJOIN datastore.gold.dim_branches db ON ft.BRANCH_LHID = db.LHID\nWHERE ft.PARSED_AMOUNT IS NOT NULL\nGROUP BY dp.PRODUCT_NAME, dp.CATEGORY, db.BRANCH_NAME, db.REGION\n",
        "dimensions": [
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product Name"
          },
          {
            "name": "product_category",
            "expr": "product_category",
            "displayName": "Product Category"
          },
          {
            "name": "branch_name",
            "expr": "branch_name",
            "displayName": "Branch Name"
          },
          {
            "name": "branch_region",
            "expr": "branch_region",
            "displayName": "Branch Region"
          }
        ],
        "measures": [
          {
            "name": "total_txn_count",
            "expr": "SUM(total_txn_count)",
            "displayName": "Total Transaction Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "refund_count",
            "expr": "SUM(refund_count)",
            "displayName": "Refund Count",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_value",
            "expr": "SUM(total_value)",
            "displayName": "Total Transaction Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "refund_value",
            "expr": "SUM(refund_value)",
            "displayName": "Refund Value",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "refund_count_pct",
            "expr": "AVG(refund_count_pct)",
            "displayName": "Refund Count Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "refund_value_pct",
            "expr": "AVG(refund_value_pct)",
            "displayName": "Refund Value Rate %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
